"""Basic Python algorithms: linear search and bubble sort with simple demo."""

from typing import List, Optional


def linear_search(arr: List[int], target: int) -> Optional[int]:
	"""Return index of target in arr or None if not found."""
	for i, v in enumerate(arr):
		if v == target:
			return i
	return None


def bubble_sort(arr: List[int]) -> List[int]:
	"""Return a sorted copy of arr using bubble sort."""
	a = arr.copy()
	n = len(a)
	for i in range(n):
		swapped = False
		for j in range(0, n - i - 1):
			if a[j] > a[j + 1]:
				a[j], a[j + 1] = a[j + 1], a[j]
				swapped = True
		if not swapped:
			break
	return a


if __name__ == "__main__":
	sample = [5, 2, 9, 1, 5, 6]
	print("Original:", sample)
	print("Sorted:", bubble_sort(sample))
	target = 5
	idx = linear_search(sample, target)
	print(f"Linear search: target {target} found at index", idx)

